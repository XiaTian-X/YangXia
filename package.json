{
  "name": "yangxia",
  "private": true,
  "description": "养夏：由 agent 驱动的作息、锻炼、饮食习惯项目",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "packages/course-core",
    "apps/sequencer",
    "apps/server",
    "apps/web"
  ],
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "templates": "node scripts/templates-path.mjs",
    "test": "vitest run",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "course": "node packages/course-core/src/cli.ts",
    "server": "node apps/server/src/index.ts",
    "server:cli": "node apps/server/src/cli.ts",
    "build": "npm run build -w @yangxia/sequencer",
    "build:web": "npm run build -w @yangxia/web",
    "build:player": "npm run build:player -w @yangxia/course-core",
    "e2e": "npm run build:e2e -w @yangxia/sequencer && npm run e2e -w @yangxia/sequencer",
    "e2e:web": "npm run build:web && npm run e2e -w @yangxia/web",
    "baseline": "node apps/sequencer/e2e/baseline.mjs",
    "snapshot": "node packages/course-core/test/export-snapshot.ts",
    "profile": "node packages/course-core/src/cli.ts profile"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "typescript": "6.0.3",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
