# 养夏自托管版环境变量示例（复制为 .env 使用，勿提交真实 .env）
PORT=3000
YANGXIA_DATA_DIR=./data
YANGXIA_TEMPLATES=./templates
# 反代后配置，例如：127.0.0.1,172.16.0.0/12
TRUSTED_PROXIES=
# 管理员本地目录迁移白名单（留空则仅支持网页 ZIP 上传）
YANGXIA_MIGRATE_DIR=
# 自动加密备份口令（至少 8 位；生产推荐用权限 600 的独立口令文件）
YANGXIA_BACKUP_PASSPHRASE=
# YANGXIA_BACKUP_PASSPHRASE_FILE=/run/secrets/yangxia_backup_passphrase
