 "documents": [
  {
   "file": "三餐菜谱手册.md"
  }
 ],
 "intake": {
  "questions": [
   {
    "id": "Q1",
    "question": "使用者处于哪个阶段",
    "options": [
     "学龄前",
     "小学",
     "初中",
     "高中",
     "18–39 岁",
     "40–64 岁",
     "65 岁以上"
    ],
    "purpose": "定年龄段。未成年人**按学段选，不按年龄**"
   },
   {
    "id": "Q2",
    "question": "安全筛查",
    "options": [
     "按年龄段逐项回答是 / 否（第三节）"
    ],
    "purpose": "按规则决定能不能直接开始"
   },
   {
    "id": "Q3",
    "question": "能用的场地（只问 18–64 岁）",
    "options": [
     "健身房",
     "家里有 2.5kg 哑铃和动感单车",
     "什么器械都没有"
    ],
    "purpose": "选场地：gym、home、bw"
   },
   {
    "id": "Q4",
    "question": "平时几点起床",
    "options": [
     "时间"
    ],
    "purpose": "算上床时间"
   }
  ],
  "bedtime": {
   "formula": "起床时间 − 目标睡眠 − 入睡缓冲",
   "buffer_minutes": 20
  },
  "stages": [
   {
    "stage": "学龄前",
    "age": null
   },
   {
    "stage": "小学",
    "age": "a06",
    "sleep_hours": 10,
    "official_bedtime": {
     "param": "BEDTIME_PRIMARY",
     "text": "小学生就寝时间一般不晚于 21:20"
    }
   },
   {
    "stage": "初中",
    "age": "a13",
    "sleep_hours": 9,
    "official_bedtime": {
     "param": "BEDTIME_JUNIOR",
     "text": "初中生就寝时间一般不晚于 22:00"
    }
   },
   {
    "stage": "高中",
    "age": "a13",
    "sleep_hours": 8,
    "official_bedtime": {
     "param": "BEDTIME_SENIOR_HS",
     "text": "高中生就寝时间一般不晚于 23:00"
    }
   },
   {
    "stage": "18–39 岁",
    "age": "a18",
    "sleep_hours": 8,
    "official_bedtime": {
     "param": "SLEEP_BEDTIME_ADULT",
     "text": "建议 22–23 点入睡"
    }
   },
   {
    "stage": "40–64 岁",
    "age": "a40",
    "sleep_hours": 8,
    "official_bedtime": {
     "param": "SLEEP_BEDTIME_ADULT",
     "text": "建议 22–23 点入睡"
    }
   },
   {
    "stage": "65 岁以上",
    "age": "a65",
    "sleep_hours": 7,
    "official_bedtime": {
     "param": "SLEEP_BEDTIME_OLDER",
     "text": "老年人推荐晚上 10–11 时入睡，早晨 5–6 时起床"
    }
   }
  ],
  "screening": [
   {
    "age": "a06",
    "product": "6-12岁-户外与游戏版（家长版）",
    "heading": "这些情况先问医生",
    "kind": "any",
    "rule": "孩子有下面任何一条，先问医生，按医生的意见安排活动",
    "items": [
     "心脏方面的问题，或者活动时胸痛、心慌、晕倒过",
     "家里有亲人年纪不大就因为心脏问题突然去世",
     "哮喘或其他慢性呼吸道疾病（问清楚运动前要不要用药、随身带什么）",
