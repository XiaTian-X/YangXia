{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "yangxia.profile/1",
  "title": "养夏个人档案",
  "description": "放在 profiles/<代号>/档案.json，不提交。用代号不用真名；安全筛查只记是 / 否，不记诊断细节和用药；训练单用到的几项条件（conditions）只记是 / 否。",
  "type": "object",
  "required": [
    "schema",
    "code",
    "stage",
    "age",
    "product",
    "screening",
    "startDate",
    "segments"
  ],
  "properties": {
    "schema": {
      "const": "yangxia.profile/1"
    },
    "code": {
      "type": "string",
      "pattern": "^[^/\\\\\\s]{1,20}$",
      "description": "代号，也是 profiles/ 下的目录名"
    },
    "stage": {
      "enum": [
        "小学",
        "初中",
        "高中",
        "18–39 岁",
        "40–64 岁",
        "65 岁以上"
      ]
    },
    "age": {
      "enum": [
        "a06",
        "a13",
        "a18",
        "a40",
        "a65"
      ]
    },
    "venue": {
      "enum": [
        "gym",
        "home",
        "bw",
        "play",
        "chair"
      ]
    },
    "product": {
      "type": "string",
      "description": "选用的成品名；等于 segments 最后一项的 product"
    },
    "birth": {
      "type": "string",
      "pattern": "^\\d{4}-(0[1-9]|1[0-2])$",
      "description": "出生年月（只记到月）。成年人必填，不在校的 13–17 岁也记；满 40 岁、满 65 岁换版靠它推算（按出生月份的 1 日算）"
    },
    "school": {
      "type": "object",
      "required": [
        "stage",
        "entry"
      ],
      "additionalProperties": false,
      "description": "在校未成年人的学段（必填）：按 9 月 1 日升学推算；高中毕业而且满 18 岁才换成人版",
      "properties": {
        "stage": {
          "enum": [
            "小学",
            "初中",
            "高中"
          ]
        },
        "entry": {
          "type": "integer",
          "minimum": 2000,
          "maximum": 2100,
          "description": "入学年份"
        },
        "system": {
          "enum": [
            "63",
            "54"
          ],
          "description": "学制：六三制（默认）或五四制"
        }
      }
    },
    "wake": {
      "type": "string",
      "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$"
    },
    "bedtime": {
      "type": "string",
      "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$"
    },
    "timezone": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "description": "可选：档案所属的 IANA 时区名（如 Asia/Shanghai）；用于按使用者所在时区算今天、周次边界和练习记录日期，不依赖服务器系统时区"
    },
    "screening": {
      "type": "object",
      "required": [
        "answers",
        "doctorCleared",
        "date"
      ],
      "properties": {
        "answers": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "item",
              "answer"
            ],
            "properties": {
              "item": {
                "type": "string"
              },
              "answer": {
                "enum": [
                  "是",
                  "否"
                ]
              }
            }
          }
        },
        "doctorCleared": {
          "type": "boolean",
          "description": "使用者说医生已经同意开始。65 岁以上必须为 true；其余年龄段有任何一项\"是\"时必须为 true"
        },
        "doctorAdvice": {
          "type": "string",
          "maxLength": 300,
          "description": "医生的意见，照使用者说的记"
        },
        "date": {
          "type": "string",
          "format": "date",
          "description": "做筛查的日期；超过 365 天要做触发评估、重做筛查"
        },
        "doctorDate": {
          "type": "string",
          "format": "date",
          "description": "医生同意的日期（doctorCleared 为 true 时必填）；要不早于最近一件要医生同意的事（筛查日期、65 岁以上摔倒、40–64 岁开工前提没过）"
        }
      }
    },
    "startDate": {
      "type": "string",
      "format": "date"
    },
    "segments": {
      "type": "array",
      "minItems": 1,
      "description": "每一周一项：第几段、阶段（起始期 4 周一段，稳定期 12 周一个周期）、段型、第几周、开始日期、成品。建档写第一项；周复盘每次追加一项（放行就加 1，重复本周不变）；段末、周期末或换成品时新开一段（n 加 1、从第 1 周起）。最后一项就是现在",
      "items": {
        "type": "object",
        "required": [
          "n",
          "type",
          "week",
          "start",
          "product"
        ],
        "properties": {
          "n": {
            "type": "integer",
            "minimum": 1
          },
          "type": {
            "enum": [
              "标准",
              "减量"
            ]
          },
          "week": {
            "type": "integer",
            "minimum": 1,
            "maximum": 12,
            "description": "这一段的第几周：起始期 1–4，稳定期 1–12"
          },
          "start": {
            "type": "string",
            "format": "date"
          },
          "product": {
            "type": "string"
          },
          "phase": {
            "enum": [
              "起始",
              "稳定"
            ],
            "description": "阶段（不写按起始）；要和成品的阶段一致，同一段里不变"
          },
          "habitTargets": {
            "type": "object",
            "description": "上一段段末结论给的习惯目标：{打卡项: {days} / {minutes} / {line}}",
            "additionalProperties": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "days": {
                  "type": "integer",
                  "minimum": 1
                },
                "minutes": {
                  "type": "integer",
                  "minimum": 1
                },
                "line": {
                  "type": "integer",
                  "minimum": 1
                }
              }
            }
          },
          "restart": {
            "type": "string",
            "pattern": "^评估/.+\\.json$",
            "description": "同一成品中途从第 1 周重来（65 岁以上生病住院回来、6–12 岁生病超过 7 天）：依据的触发评估"
          },
          "goal": {
            "enum": [
              "保持",
              "减脂",
              "增肌"
            ],
            "description": "这一周的目标（阶段 4，只给 18–64 岁稳定期）：没写的是保持；一个周期（一段）里只能从减脂、增肌退回保持"
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "phase": {
                  "const": "稳定"
                }
              },
              "required": [
                "phase"
              ]
            },
            "then": {
              "properties": {
                "type": {
                  "const": "标准"
                }
              }
            },
            "else": {
              "properties": {
                "week": {
                  "maximum": 4
                }
              }
            }
          }
        ]
      }
    },
    "conditions": {
      "type": "object",
      "description": "训练单用到的条件（高血压、骨质疏松、家里没有别人、没地方跳、家长在旁边），只记是 / 否；没记的按模板规则层的\"没确认时\"导出保守版本",
      "additionalProperties": {
        "type": "boolean"
      }
    },
    "choices": {
      "type": "array",
      "description": "能用的器材对应的选项，按优先顺序，写训练单里的原样：动作 ID（如 \"door-row\"）或带括号的占位（如 \"（门框划船）\"）；训练单\"按器材选一个\"时取第一个这一行有的",
      "items": {
        "type": "string"
      }
    },
    "progress": {
      "type": "object",
      "description": "个人进度：{动作或阶梯 ID: {level 难度级, reps 每组次数, weight 健身房重量}}。没写的按训练单的起始级、区间下限。只能经 progressLog 改",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "level": {
            "type": "integer",
            "minimum": 1
          },
          "reps": {
            "type": "integer",
            "minimum": 1
          },
          "weight": {
            "type": "number",
            "exclusiveMinimum": 0
          }
        },
        "additionalProperties": false
      }
    },
    "progressLog": {
      "type": "array",
      "description": "进度每一次改动：日期、动作、哪一项、改成多少、按哪条规则、依据（练习记录或复盘数据的文件名）。profile check 重放它，结果要等于 progress",
      "items": {
        "type": "object",
        "required": [
          "date",
          "move",
          "field",
          "to",
          "rule"
        ],
        "properties": {
          "date": {
            "type": "string",
            "format": "date"
          },
          "move": {
            "type": "string"
          },
          "field": {
            "enum": [
              "level",
              "reps",
              "weight"
            ]
          },
          "to": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "rule": {
            "enum": [
              "建档",
              "找级",
              "退回",
              "减量",
              "升级",
              "加次数",
              "调重量",
              "加重",
              "重来",
              "加一档"
            ]
          },
          "evidence": {
            "type": "string",
            "description": "依据：打卡/… 的练习记录，或 复盘/….json"
          }
        }
      }
    },
    "household": {
      "type": "array",
      "description": "一起吃饭的家庭成员（含自己）的年龄段，排菜单时记；菜单按每个年龄段的红线检查。只记年龄段，不记名字",
      "items": {
        "enum": [
          "a06",
          "a13",
          "a18",
          "a40",
          "a65"
        ]
      }
    },
    "body": {
      "enum": [
        "记",
        "不记",
        "停记"
      ],
      "description": "18–64 岁记不记体重、腰围（默认不记；出现节食、焦虑改停记，并写 bodyStopDate）。6–17 岁、65 岁以上不能写记"
    },
    "focus": {
      "type": "object",
      "required": [
        "areas"
      ],
      "additionalProperties": false,
      "description": "有基础的 18–64 岁：想先从哪方面入手（含训练的可以直接进稳定期）",
      "properties": {
        "areas": {
          "type": "array",
          "minItems": 1,
          "items": {
            "enum": [
              "作息",
              "饮食",
              "训练"
            ]
          }
        }
      }
    },
    "bodyStopDate": {
      "type": "string",
      "format": "date",
      "description": "body 改成停记的那天（停记时必填）：以前评估里记的身体数据保留，之后不再记"
    },
    "bodyLog": {
      "type": "array",
      "minItems": 1,
      "description": "可选：每次改记 / 不记 / 停记体重腰围的日期，按日期从早到晚；最后一项等于 body，最后一次停记等于 bodyStopDate。没写的由 body、bodyStopDate 推",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "date",
          "body"
        ],
        "properties": {
          "date": {
            "type": "string",
            "format": "date"
          },
          "body": {
            "enum": [
              "记",
              "不记",
              "停记"
            ]
          }
        }
      }
    },
    "cardioClear": {
      "type": "array",
      "minItems": 1,
      "description": "减脂加有氧的医生同意（有高血压或没确认、筛查有\"是\"的人）：医生每次说可以把有氧逐步加到每周 250 分钟中等强度的那天，按日期从早到晚，续了就加一项；每一周用当时有效的那一次",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "date"
        ],
        "properties": {
          "date": {
            "type": "string",
            "format": "date"
          }
        }
      }
    },
    "weightClear": {
      "type": "array",
      "minItems": 1,
      "description": "肥胖（BMI 28.0–32.4）选减脂的医生同意：医生每次说可以按这份计划减重（每天少吃约 300 kcal、有氧逐步加到每周 250 分钟）的那天，按日期从早到晚；一年有效，同时算作有氧加量的同意；重做筛查、有了新的要问医生的事以后，看医生时一起续",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "date"
        ],
        "properties": {
          "date": {
            "type": "string",
            "format": "date"
          }
        }
      }
    },
    "addClear": {
      "type": "array",
      "minItems": 1,
      "description": "65 岁以上稳定期加项的医生同意（v4 阶段 6b）：医生说可以照这份计划一轮加一项的那天和同意的那几项（加项 ID），按日期从早到晚；一年有效，重做筛查、摔倒、生病住院、看完医生回来以后要重问",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["date", "items"],
        "properties": {
          "date": { "type": "string", "format": "date" },
          "items": { "type": "array", "minItems": 1, "items": { "type": "string" } }
        }
      }
    },
    "addOnLog": {
      "type": "array",
      "description": "65 岁以上稳定期哪天加了 / 减了哪一项（v4 阶段 6b）：一轮第 1 周最多加一项；清零、失效由命令算，不用写",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["date", "item", "action", "why"],
        "properties": {
          "date": { "type": "string", "format": "date" },
          "item": { "type": "string" },
          "action": { "enum": ["加", "减"] },
          "why": { "type": "string", "minLength": 1 }
        }
      }
    },
    "dietByPro": {
      "type": "array",
      "minItems": 1,
      "description": "医生或营养师给了自己的减重方案（pro: true，吃照他们的）、不再照它（pro: false）的那天，按日期从早到晚，每次变了加一项：周期开始时是 true 的只选保持；周期中途记的，之后开始的周起退回保持；计划单按那一周开始时的写",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "date",
          "pro"
        ],
        "properties": {
          "date": {
            "type": "string",
            "format": "date"
          },
          "pro": {
            "type": "boolean"
          }
        }
      }
    },
    "habitBase": {
      "type": "object",
      "additionalProperties": {
        "type": "integer",
        "minimum": 1
      },
      "description": "65 岁以上建档时定的散步时长 {\"散步\": 分钟}（65 岁以上必填）"
    },
    "playback": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "breathLead": { "oneOf": [{ "type": "integer", "minimum": 0, "maximum": 60 }, { "const": "all" }], "description": "每组领几次\"呼、吸\"；all 是全程" },
        "breathAfter": { "enum": ["quiet", "pluck"], "description": "领完以后：安静，或者响提示音" },
        "countTiming": { "enum": ["on-rep", "on-up"], "description": "on-up 每次开始时报数，on-rep 每次做完时报数" }
      },
      "description": "播放偏好（v4 阶段 8）：本人说不要呼吸提示、想在做完时报数这类选择，只记选择，不记身体数据；course export 写进课程的 coaching.prefs，呼吸提示不低于安全下限"
    }
  }
}
