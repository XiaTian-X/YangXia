{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "yangxia.profile/1",
  "title": "养夏个人档案",
  "description": "放在 profiles/<代号>/档案.json，不提交。用代号不用真名；安全筛查只记是 / 否，不记诊断细节和用药；训练单用到的几项条件（conditions）只记是 / 否。",
  "type": "object",
  "required": [
    "schema",
    "code",
    "stage",
    "age",
    "product",
    "screening",
    "startDate",
    "segments"
  ],
  "properties": {
    "schema": {
      "const": "yangxia.profile/1"
    },
    "code": {
      "type": "string",
      "pattern": "^[^/\\\\\\s]{1,20}$",
      "description": "代号，也是 profiles/ 下的目录名"
    },
    "stage": {
      "enum": [
        "小学",
        "初中",
        "高中",
        "18–39 岁",
        "40–64 岁",
        "65 岁以上"
      ]
    },
    "age": {
      "enum": [
        "a06",
        "a13",
        "a18",
        "a40",
        "a65"
      ]
    },
    "venue": {
      "enum": [
        "gym",
        "home",
        "bw",
        "play",
        "chair"
      ]
    },
    "product": {
      "type": "string",
      "description": "选用的成品名；等于 segments 最后一项的 product"
    },
    "birth": {
      "type": "string",
      "pattern": "^\\d{4}-(0[1-9]|1[0-2])$",
      "description": "出生年月（只记到月）。成年人必填，不在校的 13–17 岁也记；满 40 岁、满 65 岁换版靠它推算（按出生月份的 1 日算）"
    },
    "school": {
      "type": "object",
      "required": [
        "stage",
        "entry"
      ],
      "additionalProperties": false,
      "description": "在校未成年人的学段（必填）：按 9 月 1 日升学推算；高中毕业而且满 18 岁才换成人版",
      "properties": {
        "stage": {
          "enum": [
            "小学",
            "初中",
            "高中"
          ]
        },
        "entry": {
          "type": "integer",
          "minimum": 2000,
          "maximum": 2100,
          "description": "入学年份"
        },
        "system": {
          "enum": [
            "63",
            "54"
          ],
          "description": "学制：六三制（默认）或五四制"
        }
      }
    },
    "wake": {
      "type": "string",
      "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$"
    },
    "bedtime": {
      "type": "string",
      "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$"
    },
    "screening": {
      "type": "object",
      "required": [
        "answers",
        "doctorCleared",
        "date"
      ],
      "properties": {
        "answers": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "item",
              "answer"
            ],
            "properties": {
              "item": {
                "type": "string"
              },
              "answer": {
                "enum": [
                  "是",
                  "否"
                ]
              }
            }
          }
        },
        "doctorCleared": {
          "type": "boolean",
          "description": "使用者说医生已经同意开始。65 岁以上必须为 true；其余年龄段有任何一项\"是\"时必须为 true"
        },
        "doctorAdvice": {
          "type": "string",
          "maxLength": 300,
          "description": "医生的意见，照使用者说的记"
        },
        "date": {
          "type": "string",
          "format": "date",
          "description": "做筛查的日期；超过 365 天要做触发评估、重做筛查"
        },
        "doctorDate": {
          "type": "string",
          "format": "date",
          "description": "医生同意的日期（doctorCleared 为 true 时必填）；要不早于最近一件要医生同意的事（筛查日期、65 岁以上摔倒、40–64 岁开工前提没过）"
        }
      }
    },
    "startDate": {
      "type": "string",
      "format": "date"
    },
    "segments": {
      "type": "array",
      "minItems": 1,
      "description": "每一周一项：第几段、阶段（起始期 4 周一段，稳定期 12 周一个周期）、段型、第几周、开始日期、成品。建档写第一项；周复盘每次追加一项（放行就加 1，重复本周不变）；段末、周期末或换成品时新开一段（n 加 1、从第 1 周起）。最后一项就是现在",
      "items": {
        "type": "object",
        "required": [
          "n",
          "type",
          "week",
          "start",
          "product"
        ],
        "properties": {
          "n": {
            "type": "integer",
            "minimum": 1
          },
          "type": {
            "enum": [
              "标准",
              "减量"
            ]
          },
          "week": {
            "type": "integer",
            "minimum": 1,
            "maximum": 12,
            "description": "这一段的第几周：起始期 1–4，稳定期 1–12"
          },
          "start": {
            "type": "string",
            "format": "date"
          },
          "product": {
            "type": "string"
          },
          "phase": {
            "enum": [
              "起始",
              "稳定"
            ],
            "description": "阶段（不写按起始）；要和成品的阶段一致，同一段里不变"
          },
          "habitTargets": {
            "type": "object",
            "description": "上一段段末结论给的习惯目标：{打卡项: {days} / {minutes} / {line}}",
            "additionalProperties": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "days": {
                  "type": "integer",
                  "minimum": 1
                },
                "minutes": {
                  "type": "integer",
                  "minimum": 1
                },
                "line": {
                  "type": "integer",
                  "minimum": 1
                }
              }
            }
          },
          "restart": {
            "type": "string",
            "pattern": "^评估/.+\\.json$",
            "description": "同一成品中途从第 1 周重来（65 岁以上生病住院回来、6–12 岁生病超过 7 天）：依据的触发评估"
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "phase": {
                  "const": "稳定"
                }
              },
              "required": [
                "phase"
              ]
            },
            "then": {
              "properties": {
                "type": {
                  "const": "标准"
                }
              }
            },
            "else": {
              "properties": {
                "week": {
                  "maximum": 4
                }
              }
            }
          }
        ]
      }
    },
    "conditions": {
      "type": "object",
      "description": "训练单用到的条件（高血压、骨质疏松、家里没有别人、没地方跳、家长在旁边），只记是 / 否；没记的按模板规则层的\"没确认时\"导出保守版本",
      "additionalProperties": {
        "type": "boolean"
      }
    },
    "choices": {
      "type": "array",
      "description": "能用的器材对应的动作 ID，按优先顺序（如 [\"door-row\"]）；训练单\"按器材选一个\"时取第一个能用的",
      "items": {
        "type": "string"
      }
    },
    "progress": {
      "type": "object",
      "description": "个人进度：{动作或阶梯 ID: {level 难度级, reps 每组次数, weight 健身房重量}}。没写的按训练单的起始级、区间下限。只能经 progressLog 改",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "level": {
            "type": "integer",
            "minimum": 1
          },
          "reps": {
            "type": "integer",
            "minimum": 1
          },
          "weight": {
            "type": "number",
            "exclusiveMinimum": 0
          }
        },
        "additionalProperties": false
      }
    },
    "progressLog": {
      "type": "array",
      "description": "进度每一次改动：日期、动作、哪一项、改成多少、按哪条规则、依据（练习记录或复盘数据的文件名）。profile check 重放它，结果要等于 progress",
      "items": {
        "type": "object",
        "required": [
          "date",
          "move",
          "field",
          "to",
          "rule"
        ],
        "properties": {
          "date": {
            "type": "string",
            "format": "date"
          },
          "move": {
            "type": "string"
          },
          "field": {
            "enum": [
              "level",
              "reps",
              "weight"
            ]
          },
          "to": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "rule": {
            "enum": [
              "建档",
              "找级",
              "退回",
              "减量",
              "升级",
              "加次数",
              "调重量",
              "加重",
              "重来",
              "加一档"
            ]
          },
          "evidence": {
            "type": "string",
            "description": "依据：打卡/… 的练习记录，或 复盘/….json"
          }
        }
      }
    },
    "household": {
      "type": "array",
      "description": "一起吃饭的家庭成员（含自己）的年龄段，排菜单时记；菜单按每个年龄段的红线检查。只记年龄段，不记名字",
      "items": {
        "enum": [
          "a06",
          "a13",
          "a18",
          "a40",
          "a65"
        ]
      }
    },
    "body": {
      "enum": [
        "记",
        "不记",
        "停记"
      ],
      "description": "18–64 岁记不记体重、腰围（默认不记；出现节食、焦虑改停记，并写 bodyStopDate）。6–17 岁、65 岁以上不能写记"
    },
    "focus": {
      "type": "object",
      "required": [
        "areas"
      ],
      "additionalProperties": false,
      "description": "有基础的 18–64 岁：想先从哪方面入手（含训练的可以直接进稳定期）",
      "properties": {
        "areas": {
          "type": "array",
          "minItems": 1,
          "items": {
            "enum": [
              "作息",
              "饮食",
              "训练"
            ]
          }
        }
      }
    },
    "bodyStopDate": {
      "type": "string",
      "format": "date",
      "description": "body 改成停记的那天（停记时必填）：以前评估里记的身体数据保留，之后不再记"
    },
    "habitBase": {
      "type": "object",
      "additionalProperties": {
        "type": "integer",
        "minimum": 1
      },
      "description": "65 岁以上建档时定的散步时长 {\"散步\": 分钟}（65 岁以上必填）"
    }
  }
}
