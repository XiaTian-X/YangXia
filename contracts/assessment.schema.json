{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "yangxia.assessment/1",
  "title": "养夏评估记录",
  "description": "放在 profiles/<代号>/评估/<日期>-<种类>.json，不提交。测试项、参数、下一轮的方向都来自模板规则层（rules.json 的 assess、nextRound、habits）；结论由 npm run course -- assess 重算，写的结论对不上就报错。6–17 岁不记身高、体重、腰围、BMI；65 岁以上不记这些数字；不记身材照片、血压数值、体检结果；跌倒风险只记 65 岁以上自查的答案、秒数和测试条件（等级由命令算出写进结论）和正式评估时医生说的等级。",
  "type": "object",
  "required": [
    "schema",
    "date",
    "kind"
  ],
  "properties": {
    "schema": {
      "const": "yangxia.assessment/1"
    },
    "date": {
      "type": "string",
      "format": "date",
      "description": "评估的日期"
    },
    "kind": {
      "enum": [
        "入门",
        "段末",
        "周期末",
        "触发"
      ],
      "description": "周期末：稳定期第 12 周之后"
    },
    "product": {
      "type": "string",
      "description": "评估针对的成品；跨段、换场地的触发评估写新成品"
    },
    "segment": {
      "type": "integer",
      "minimum": 1,
      "description": "段末、周期末评估：第几段"
    },
    "reasons": {
      "type": "array",
      "minItems": 1,
      "items": {
        "enum": [
          "跨段",
          "满一年",
          "身体变化",
          "生病住院",
          "生病",
          "摔倒",
          "换场地",
          "中断",
          "看完医生回来",
          "回起始期",
          "跌倒自查到期"
        ]
      },
      "description": "触发评估的原因"
    },
    "base": {
      "enum": [
        0,
        1,
        2
      ],
      "description": "最近 3 个月平均每周几天力量练习（2 = 2 天及以上），只记录"
    },
    "prereqs": {
      "type": "object",
      "additionalProperties": {
        "type": "boolean"
      },
      "description": "40–64 岁开工前提 {checkup, bpOk}，只记是 / 否"
    },
    "body": {
      "type": "object",
      "additionalProperties": false,
      "description": "只限档案选了记的 18–64 岁",
      "properties": {
        "height": {
          "type": "number",
          "minimum": 100,
          "maximum": 230
        },
        "weight": {
          "type": "number",
          "minimum": 25,
          "maximum": 300
        },
        "waist": {
          "type": "number",
          "minimum": 40,
          "maximum": 200
        }
      }
    },
    "tests": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "level": {
            "type": "integer",
            "minimum": 1
          },
          "value": {
            "type": "number",
            "minimum": 0
          },
          "depth": {
            "type": "string",
            "maxLength": 30
          },
          "mode": {
            "enum": [
              "稳态分钟",
              "间歇轮数"
            ]
          },
          "move": {
            "type": "string"
          },
          "hands": {
            "enum": [
              "不用手",
              "扶椅子",
              "手撑"
            ]
          },
          "done": {
            "type": "boolean"
          },
          "stopReason": {
            "enum": [
              "头晕",
              "腿软",
              "身体晃"
            ]
          }
        }
      }
    },
    "companion": {
      "type": "boolean",
      "description": "65 岁以上测试时家人在场"
    },
    "doctorCleared": {
      "type": "boolean"
    },
    "doctorDate": {
      "type": "string",
      "format": "date"
    },
    "eventDate": {
      "type": "string",
      "format": "date",
      "description": "摔倒、生病住院那天"
    },
    "fallAssessDone": {
      "type": "boolean",
      "description": "65 岁以上年度复评：这一年做过跌倒风险评估没有（不记等级）"
    },
    "weightDrop": {
      "type": "boolean",
      "description": "65 岁以上：体重有没有明显下降（不记数字）"
    },
    "conclusion": {
      "type": "object",
      "description": "照 course assess 的输出写。周期末的 next 是 {phase, type?, hold?}"
    },
    "note": {
      "type": "string",
      "maxLength": 500
    },
    "doctorRestart": {
      "type": "boolean",
      "description": "医生建议从头来（稳定期中途回起始期的依据）"
    },
    "fallRisk": {
      "type": "object",
      "description": "65 岁以上的跌倒风险自查（照 WS/T 887—2026 第 5 章，不是正式评估）：只记是 / 否、秒数和测试条件，不记病名、用药、体重数字",
      "additionalProperties": false,
      "required": [
        "askedOn",
        "general",
        "needsSupport",
        "hardToStand",
        "dizzy"
      ],
      "properties": {
        "askedOn": {
          "type": "string",
          "format": "date"
        },
        "general": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "fell",
            "unsteady",
            "fear"
          ],
          "properties": {
            "fell": {
              "type": "boolean"
            },
            "unsteady": {
              "type": [
                "boolean",
                "null"
              ]
            },
            "fear": {
              "type": [
                "boolean",
                "null"
              ]
            }
          }
        },
        "severity": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "twoPlus",
            "medical",
            "helpUp",
            "syncope"
          ],
          "properties": {
            "twoPlus": {
              "type": "boolean"
            },
            "medical": {
              "type": "boolean"
            },
            "helpUp": {
              "type": "boolean"
            },
            "syncope": {
              "type": "boolean"
            }
          }
        },
        "frail": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "fatigue",
            "stairs",
            "walk",
            "illness",
            "weightLoss"
          ],
          "properties": {
            "fatigue": {
              "type": "boolean"
            },
            "stairs": {
              "type": "boolean"
            },
            "walk": {
              "type": "boolean"
            },
            "illness": {
              "type": "boolean"
            },
            "weightLoss": {
              "type": "boolean"
            }
          }
        },
        "needsSupport": {
          "type": "boolean"
        },
        "hardToStand": {
          "type": "boolean"
        },
        "dizzy": {
          "type": "boolean",
          "description": "问卷那天安全筛查\"经常头晕，或者站起来时眼前发黑\"的答案：照那天的筛查填，以后重做筛查不改它"
        },
        "walk4m": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "seconds",
                "cane",
                "siteOk",
                "testedOn"
              ],
              "properties": {
                "seconds": {
                  "type": "number",
                  "exclusiveMinimum": 0,
                  "exclusiveMaximum": 600,
                  "description": "往大里取到一位小数（5.04 秒记 5.1 秒）；一位小数由代码查（JSON Schema 的 multipleOf 对小数不可靠）"
                },
                "cane": {
                  "type": "boolean"
                },
                "siteOk": {
                  "type": "boolean"
                },
                "testedOn": {
                  "type": "string",
                  "format": "date"
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "result",
                "reason"
              ],
              "properties": {
                "result": {
                  "const": "没测成"
                },
                "reason": {
                  "enum": [
                    "场地不够",
                    "椅子不合要求",
                    "家人不在",
                    "本人不想测",
                    "中途停下"
                  ]
                },
                "stopReason": {
                  "enum": [
                    "头晕",
                    "腿软",
                    "身体晃"
                  ]
                },
                "testedOn": {
                  "type": "string",
                  "format": "date"
                }
              },
              "if": {
                "properties": {
                  "reason": {
                    "const": "中途停下"
                  }
                }
              },
              "then": {
                "required": [
                  "stopReason"
                ]
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "result",
                "reason"
              ],
              "properties": {
                "result": {
                  "const": "按规则不测"
                },
                "reason": {
                  "enum": [
                    "跌倒过",
                    "高风险",
                    "走路要扶",
                    "站起困难",
                    "经常头晕"
                  ]
                }
              }
            }
          ]
        },
        "tug": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "seconds",
                "cane",
                "siteOk",
                "chairOk",
                "testedOn"
              ],
              "properties": {
                "seconds": {
                  "type": "number",
                  "exclusiveMinimum": 0,
                  "exclusiveMaximum": 600,
                  "description": "往大里取到一位小数（5.04 秒记 5.1 秒）；一位小数由代码查（JSON Schema 的 multipleOf 对小数不可靠）"
                },
                "cane": {
                  "type": "boolean"
                },
                "siteOk": {
                  "type": "boolean"
                },
                "chairOk": {
                  "type": "boolean"
                },
                "testedOn": {
                  "type": "string",
                  "format": "date"
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "result",
                "reason"
              ],
              "properties": {
                "result": {
                  "const": "没测成"
                },
                "reason": {
                  "enum": [
                    "场地不够",
                    "椅子不合要求",
                    "家人不在",
                    "本人不想测",
                    "中途停下"
                  ]
                },
                "stopReason": {
                  "enum": [
                    "头晕",
                    "腿软",
                    "身体晃"
                  ]
                },
                "testedOn": {
                  "type": "string",
                  "format": "date"
                }
              },
              "if": {
                "properties": {
                  "reason": {
                    "const": "中途停下"
                  }
                }
              },
              "then": {
                "required": [
                  "stopReason"
                ]
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "result",
                "reason"
              ],
              "properties": {
                "result": {
                  "const": "按规则不测"
                },
                "reason": {
                  "enum": [
                    "跌倒过",
                    "高风险",
                    "走路要扶",
                    "站起困难",
                    "经常头晕"
                  ]
                }
              }
            }
          ]
        }
      }
    },
    "fallRiskSeen": {
      "type": "boolean",
      "description": "医生看过这份跌倒风险自查的结果"
    },
    "official": {
      "type": "object",
      "description": "医生或社区做的正式跌倒风险评估",
      "additionalProperties": false,
      "required": [
        "date",
        "afterFall"
      ],
      "properties": {
        "date": {
          "type": "string",
          "format": "date"
        },
        "afterFall": {
          "type": "boolean"
        },
        "level": {
          "enum": [
            "低",
            "中",
            "高"
          ]
        }
      }
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "reasons": {
            "contains": {
              "enum": [
                "摔倒",
                "生病住院"
              ]
            }
          }
        },
        "required": [
          "reasons"
        ]
      },
      "then": {
        "required": [
          "eventDate"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "enum": [
              "段末",
              "周期末"
            ]
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "required": [
          "segment"
        ]
      }
    }
  ]
}
