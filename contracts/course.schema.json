{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "yangxia.course/1",
  "title": "养夏跟练课程",
  "description": "一天的训练，按成品原样导出。读的一方忽略不认识的字段。字段说明见 docs/数据约定.md。",
  "type": "object",
  "required": [
    "schema",
    "id",
    "name",
    "age",
    "source",
    "blocks"
  ],
  "properties": {
    "schema": {
      "const": "yangxia.course/1"
    },
    "id": {
      "type": "string",
      "pattern": "^c_[a-z0-9]{6,40}$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 60
    },
    "age": {
      "enum": [
        "a13",
        "a18",
        "a40",
        "a65"
      ],
      "description": "年龄段代码，和模板 manifest 的 products[].age 一致"
    },
    "source": {
      "type": "object",
      "required": [
        "product",
        "week"
      ],
      "properties": {
        "product": {
          "type": "string",
          "minLength": 1,
          "description": "成品名，如 18-39岁-居家版"
        },
        "templates": {
          "type": "string",
          "description": "模板版本，如 v3.0"
        },
        "week": {
          "type": "integer",
          "minimum": 1,
          "maximum": 12,
          "description": "第几周：起始期 1–4，稳定期 1–12"
        },
        "day": {
          "type": "string",
          "maxLength": 20,
          "description": "训练日，如 A、B、C、D"
        },
        "plan": {
          "const": "yangxia.plans/1",
          "description": "由 course export 从训练单导出；课程检查按训练单和档案进度逐项核对"
        },
        "segment": {
          "type": "integer",
          "minimum": 1,
          "maximum": 99,
          "description": "第几段"
        },
        "type": {
          "enum": [
            "标准",
            "减量"
          ],
          "description": "段型"
        },
        "phase": {
          "enum": [
            "起始",
            "稳定"
          ],
          "description": "阶段：起始期（4 周一段）、稳定期（12 周一个周期）"
        },
        "picks": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "description": "轮换组这一次做哪一个：{组名: 动作 ID}"
        },
        "half": {
          "const": true,
          "description": "半量课：中断、生病回来的第一次，每个动作组数、循环轮数减半向上取整（设计值 HALF），不当加量依据"
        }
      },
      "allOf": [
        {
          "if": {
            "not": {
              "properties": {
                "phase": {
                  "const": "稳定"
                }
              },
              "required": [
                "phase"
              ]
            }
          },
          "then": {
            "properties": {
              "week": {
                "maximum": 4
              }
            }
          }
        }
      ],
      "additionalProperties": false
    },
    "blocks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "items": {
        "$ref": "#/$defs/block"
      }
    },
    "presentation": {
      "type": "object",
      "description": "编排器怎么播（音色、鼓点、画面），别的项目可以忽略。sequencer 里和安全有关的呼吸提示写错不合格；外观项写错只提醒，编排器回到默认值",
      "properties": {
        "sequencer": {
          "type": "object",
          "properties": {
            "breath": {
              "enum": [
                "coach",
                "full-voice",
                "pluck",
                "off"
              ],
              "description": "旧写法，读的时候对应到 breathLead + breathAfter"
            },
            "breathLead": {
              "oneOf": [
                {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 60
                },
                {
                  "const": "all"
                }
              ],
              "description": "每组领几次\"呼、吸\"；all 是全程"
            },
            "breathAfter": {
              "enum": [
                "quiet",
                "pluck"
              ],
              "description": "领完以后：安静，或者在换气的拍响提示音"
            }
          }
        }
      }
    },
    "coaching": {
      "type": "object",
      "description": "由 course export 写：档案里本人的播放偏好、呼吸提示的下限；不写病情",
      "properties": {
        "floor": {
          "const": "pluck",
          "description": "领完以后至少响提示音（全程也算满足）"
        },
        "prefs": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "breathLead": {
              "oneOf": [
                {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 60
                },
                {
                  "const": "all"
                }
              ]
            },
            "breathAfter": {
              "enum": [
                "quiet",
                "pluck"
              ]
            },
            "countTiming": {
              "enum": [
                "on-rep",
                "on-up"
              ]
            }
          }
        }
      }
    }
  },
  "$defs": {
    "block": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "kind",
            "items"
          ],
          "properties": {
            "kind": {
              "const": "sets"
            },
            "items": {
              "type": "array",
              "minItems": 1,
              "maxItems": 12,
              "items": {
                "$ref": "#/$defs/item"
              }
            }
          }
        },
        {
          "type": "object",
          "required": [
            "kind",
            "rounds",
            "items"
          ],
          "properties": {
            "kind": {
              "const": "circuit"
            },
            "rounds": {
              "type": "integer",
              "minimum": 1,
              "maximum": 10
            },
            "restBetweenRounds": {
              "type": "integer",
              "minimum": 0,
              "maximum": 300
            },
            "items": {
              "type": "array",
              "minItems": 1,
              "maxItems": 12,
              "items": {
                "allOf": [
                  {
                    "$ref": "#/$defs/item"
                  },
                  {
                    "properties": {
                      "sets": {
                        "const": 1
                      }
                    }
                  }
                ]
              }
            }
          }
        }
      ]
    },
    "seconds": {
      "type": "number",
      "minimum": 0,
      "maximum": 10,
      "multipleOf": 0.5
    },
    "item": {
      "type": "object",
      "required": [
        "exercise",
        "name",
        "mode",
        "rest",
        "quote"
      ],
      "properties": {
        "exercise": {
          "type": "string",
          "pattern": "^[a-z0-9-]+$",
          "description": "模板动作索引的 ID"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 24
        },
        "mode": {
          "enum": [
            "reps",
            "timed"
          ]
        },
        "sets": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10,
          "default": 1
        },
        "reps": {
          "type": "integer",
          "minimum": 1,
          "maximum": 60
        },
        "duration": {
          "type": "integer",
          "minimum": 5,
          "maximum": 600,
          "description": "计时动作每组秒数"
        },
        "perSide": {
          "type": "boolean",
          "default": false
        },
        "tempo": {
          "type": "object",
          "required": [
            "start",
            "up",
            "down"
          ],
          "description": "单位是秒。start：一次动作从发力（up）还是下放（down）开始",
          "properties": {
            "start": {
              "enum": [
                "up",
                "down"
              ]
            },
            "up": {
              "allOf": [
                {
                  "$ref": "#/$defs/seconds"
                },
                {
                  "minimum": 0.5
                }
              ]
            },
            "top": {
              "$ref": "#/$defs/seconds"
            },
            "down": {
              "allOf": [
                {
                  "$ref": "#/$defs/seconds"
                },
                {
                  "minimum": 0.5
                }
              ]
            },
            "bottom": {
              "$ref": "#/$defs/seconds"
            }
          }
        },
        "rest": {
          "type": "integer",
          "minimum": 0,
          "maximum": 300,
          "description": "这一项每组之后的休息秒数"
        },
        "quote": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "items": {
            "type": "string",
            "minLength": 2,
            "maxLength": 200
          },
          "description": "成品原文：组数、次数、秒数、休息都要能在这里找到出处"
        },
        "figure": {
          "type": "string",
          "pattern": "^[a-z0-9-]+(#[0-9]+)?$",
          "description": "动作示意动图的片段号（模板 dist/data/motions.json 的键）。course export 写，这一级有合适的动图才有；手写课程不写"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "mode": {
                "const": "reps"
              }
            }
          },
          "then": {
            "required": [
              "reps",
              "tempo"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "mode": {
                "const": "timed"
              }
            }
          },
          "then": {
            "required": [
              "duration"
            ]
          }
        }
      ]
    }
  }
}
