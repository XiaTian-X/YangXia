{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "yangxia.review/1",
  "title": "养夏周复盘数据",
  "description": "放在 profiles/<代号>/复盘/<这一周的开始日期>-第N周.json，和同名 .md 成对，不提交。数字照使用者说的填；profile check 拿它核对训练次数、不适和进度改动的依据。",
  "type": "object",
  "required": [
    "schema",
    "start",
    "week",
    "trainings",
    "symptoms",
    "moves"
  ],
  "properties": {
    "schema": {
      "const": "yangxia.review/1"
    },
    "start": {
      "type": "string",
      "format": "date",
      "description": "这一周的开始日期（segments 里那一项的 start）"
    },
    "week": {
      "type": "integer",
      "minimum": 1,
      "maximum": 12
    },
    "trainings": {
      "type": "integer",
      "minimum": 0,
      "description": "这一周练了几次（不能少于这一周的练习记录数）"
    },
    "checkinDays": {
      "type": "integer",
      "minimum": 0,
      "maximum": 7,
      "description": "每日打卡达标的天数"
    },
    "symptoms": {
      "type": "boolean",
      "description": "这一周有没有疼痛、头晕、胸闷（练习记录里有，就不能写没有）"
    },
    "moves": {
      "type": "array",
      "description": "逐个动作的表现",
      "items": {
        "type": "object",
        "required": [
          "move",
          "allAtTop",
          "spare"
        ],
        "properties": {
          "move": {
            "type": "string",
            "description": "动作或阶梯 ID"
          },
          "allAtTop": {
            "type": "boolean",
            "description": "每组都做到了区间上限"
          },
          "spare": {
            "type": "integer",
            "minimum": 0,
            "description": "最后一组还剩几次余力"
          }
        }
      }
    },
    "note": {
      "type": "string",
      "maxLength": 500
    },
    "habits": {
      "type": "object",
      "additionalProperties": {
        "type": "integer",
        "minimum": 0,
        "maximum": 7
      },
      "description": "这一周每项打卡项达标几天，打卡项照模板 打卡.md"
    },
    "falls": {
      "type": "integer",
      "minimum": 0,
      "description": "65 岁以上：这一周摔倒几次"
    },
    "nearFalls": {
      "type": "integer",
      "minimum": 0,
      "description": "65 岁以上：差点摔倒几次"
    },
    "dizzy": {
      "type": "integer",
      "minimum": 0,
      "description": "65 岁以上：头晕几次"
    },
    "sickDays": {
      "type": "integer",
      "minimum": 0,
      "maximum": 7,
      "description": "6–12 岁：这一周生病几天"
    },
    "sickOrMeds": {
      "type": "boolean",
      "description": "65 岁以上：这一周有没有生病、换药（是就做触发评估）"
    },
    "weightDrop": {
      "type": "boolean",
      "description": "65 岁以上：体重有没有明显下降（不记数字；是就提醒问医生）"
    },
    "half": {
      "type": "boolean",
      "description": "这一周练过半量课：这份复盘不当加量依据"
    },
    "steadyCheck": {
      "type": "boolean",
      "description": "这一轮第 2 周的稳态自查过没过（做完能说完整句子、第二天不觉得累）；没过或没记，这一轮第 3–4 周继续稳态"
    }
  }
}
