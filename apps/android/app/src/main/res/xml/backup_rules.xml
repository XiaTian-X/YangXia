<?xml version="1.0" encoding="utf-8"?>
<!-- Android 8–11（API 26–30）全面禁止系统备份导出健康缓存与凭据 -->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="file" path="." />
</full-backup-content>
