#!/usr/bin/env python3
"""提交前检查：拒绝把个人数据、密钥、超大文件提交进仓库。只用 Python 标准库。

启用（每个克隆做一次）：模板仓库 `python3 tpl.py setup`，主仓库 `npm run setup`，
两者都等价于 `git config core.hooksPath .githooks`。

主仓库和模板仓库用的是同一份脚本，改了要两边同步。
不要用 `git commit --no-verify` / `-n` 跳过它。
"""
import re
import subprocess
import sys

MAX_BYTES = 5 * 1024 * 1024
SIZE_EXEMPT: set[str] = set()                # 没有例外；PDF 手册不提交，发版时放进 GitHub Release
FIXTURE_PREFIXES = ("contracts/fixtures/",)  # 只有这里允许出现个人档案 / 练习记录格式的样例

BLOCK_PATH = [
    (re.compile(r"^profiles/"), "个人数据目录 profiles/"),      # 和 .gitignore 的 /profiles/ 一致；别处的档案靠内容检查拦
    (re.compile(r"(^|/)\.env(\.|$)"), "环境变量文件 .env"),
    (re.compile(r"\.(pem|key|p12|pfx|keystore|secret)$"), "密钥 / 证书文件"),
    (re.compile(r"(^|/)id_(rsa|ed25519)"), "SSH 私钥"),
    (re.compile(r"(^|/)credentials[^/]*\.json$"), "凭据文件"),
    (re.compile(r"(^|/)secrets\.[^/]+$"), "凭据文件"),
    (re.compile(r"(^|/)\.secrets/"), "凭据目录"),
    (re.compile(r"(^|/)\.(npmrc|netrc)$"), "可能含令牌的配置文件"),
    (re.compile(r"(^|/)\.claude/settings\.local\.json$"), "Claude Code 个人设置"),
    (re.compile(r"(^|/)CLAUDE\.local\.md$"), "Claude Code 个人说明"),
    (re.compile(r"\.ics$"), "日历文件（训练安排属于个人数据）"),
    (re.compile(r"^data/"), "自托管服务端运行数据目录 data/"),
    (re.compile(r"(^|/)master\.key$"), "服务端加密主密钥 master.key"),
    (re.compile(r"\.(sqlite|sqlite-wal|sqlite-shm|db|yxbackup)$"), "数据库或加密备份文件"),
    (re.compile(r"\.(jks|apk|aab)$"), "Android 签名密钥或安装包产物"),
]
ALLOW_PATH = [re.compile(r"(^|/)\.env\.example$")]

CONTENT = [
    (re.compile(rb"-----BEGIN [A-Z ]*PRIVATE KEY-----"), "私钥"),
    (re.compile(rb"\bsk-[A-Za-z0-9_-]{20,}"), "API 密钥（sk-…）"),
    (re.compile(rb"\bghp_[A-Za-z0-9]{30,}"), "GitHub 令牌（ghp_…）"),
    (re.compile(rb"\bgithub_pat_[A-Za-z0-9_]{30,}"), "GitHub 令牌（github_pat_…）"),
    (re.compile(rb"\bAKIA[0-9A-Z]{16}\b"), "AWS 访问密钥"),
]
# 声明自己是个人档案 / 练习记录的数据文件（JSON 的 "schema": "…"，含压成一行的 {"schema":…}；或 Markdown 开头的 schema: …）
PERSONAL = re.compile(rb'(^|[\n{,])\s*"?schema"?\s*:\s*"?yangxia\.(profile|session|review|assessment)/')
TEMPLATE_DIRS = ("content/", "tools/", "dist/")   # 模板仓库：改了这些就要跑 tpl.py check


def git(*args):
    return subprocess.run(["git", *args], capture_output=True, check=True).stdout


def template_checks(paths):
    """只在模板仓库（根目录有 tpl.py）里做：暂存了 content/、tools/、dist/ 的改动时，
    这三处不能有没暂存的改动或没跟踪的新文件（否则查的是工作区、提交的是暂存区），再跑一遍 python3 tpl.py check。"""
    import os
    root = git("rev-parse", "--show-toplevel").decode("utf-8").strip()
    if not os.path.exists(os.path.join(root, "tpl.py")) or not any(p.startswith(TEMPLATE_DIRS) for p in paths):
        return []
    dirs = [d.rstrip("/") for d in TEMPLATE_DIRS]
    loose = [p.decode("utf-8") for p in git("diff", "--name-only", "-z", "--", *dirs).split(b"\0") if p]
    loose += [p.decode("utf-8") for p in git("ls-files", "--others", "--exclude-standard", "-z", "--", *dirs).split(b"\0") if p]
    if loose:
        shown = "、".join(loose[:5]) + ("……" if len(loose) > 5 else "")
        return [f"content/、tools/、dist/ 还有没暂存的改动或没跟踪的新文件（{shown}）：先 git add 或撤销，"
                "提交前检查查的是工作区，要和要提交的内容一致"]
    # 提交时必须和上一发布版比对动作库（普通副本没有标签可以跳过，提交不行）
    env = {**os.environ, "YANGXIA_REQUIRE_BASELINE": "1"}
    r = subprocess.run([sys.executable, "tpl.py", "check"], cwd=root, capture_output=True, text=True, env=env)
    if r.returncode:
        tail = [ln for ln in r.stdout.splitlines() if ln.startswith("[错误]")][:8]
        return ["python3 tpl.py check 没通过（先 python3 tpl.py all，改到 0 错误）：", *[f"    {t}" for t in tail]]
    return []


def main():
    # -z：不转义中文路径（默认会输出成 "\345…"，按前缀匹配会漏掉）
    raw = git("diff", "--cached", "--name-only", "-z", "--diff-filter=ACMRT")
    paths = [p.decode("utf-8") for p in raw.split(b"\0") if p]
    problems = []
    for path in paths:
        if not any(p.search(path) for p in ALLOW_PATH):
            for pat, what in BLOCK_PATH:
                if pat.search(path):
                    problems.append(f"{path}：{what}，不能提交")
                    break
        blob = git("show", f":{path}")
        if len(blob) > MAX_BYTES and path not in SIZE_EXEMPT:
            problems.append(f"{path}：{len(blob) / 1024 / 1024:.1f} MB，超过 5 MB")
        for pat, what in CONTENT:
            if pat.search(blob):
                problems.append(f"{path}：内容里像是有{what}")
        if not path.startswith(FIXTURE_PREFIXES) and PERSONAL.search(blob):
            problems.append(f"{path}：这是个人档案或练习记录，只能放在 profiles/（不提交）")
    problems += template_checks(paths)
    if problems:
        print("提交前检查没通过：", file=sys.stderr)
        for p in problems:
            print(f"  - {p}", file=sys.stderr)
        print("个人数据、密钥、大文件：移出暂存区（git restore --staged <文件>）后再提交；模板核对：改到通过再提交。", file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main())
