.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*~

# 临时、缓存
__pycache__/
*.pyc
.pytest_cache/
.cache/
tmp/
*.tmp
*.log

# 密钥、凭据
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
*.keystore
id_rsa*
id_ed25519*
